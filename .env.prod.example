# Production (copier ce fichier en .env.prod, ne jamais le versionner)
# openssl rand -hex 16   (hexadécimal : la valeur est insérée dans une URL)
POSTGRES_PASSWORD=
# openssl rand -base64 32
AUTH_SECRET=
# Adresse publique du site, OBLIGATOIRE : elle sert à construire les liens
# envoyés par e-mail (jamais l'en-tête Host fourni par le visiteur).
AUTH_URL=http://localhost:3000

# Envoi des e-mails (réinitialisation du mot de passe). Sans SMTP_HOST, le lien
# est seulement écrit dans les journaux du conteneur (docker compose logs app).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=SlamGement <no-reply@example.com>
