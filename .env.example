# Développement local (copier ce fichier en .env)
DATABASE_URL="postgresql://slamgement:slamgement_dev@localhost:5432/slamgement"
# Générer une valeur aléatoire : openssl rand -base64 32
AUTH_SECRET="remplace-par-une-valeur-aleatoire"

# --- Facultatif : envoi réel des e-mails (réinitialisation du mot de passe) ---
